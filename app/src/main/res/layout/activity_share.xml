<?xml version="1.0" encoding="utf-8"?>
<!-- The share page (user 2026-11-25): a line of words, the web page's address as a QR code in a white box under it, and
     under that the address as a link that copies itself when tapped. The colours and the box are set in ShareActivity
     (Ui.box), which also makes the code as large as the screen allows; 200 dp here, until then, fits the lowest phone
     held sideways. The code is drawable/share_qr, made by tools/make_qr.py. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="@string/share_title"
        android:textColor="#000000"
        android:textSize="24sp"
        android:fontFamily="@font/inter_bold" />

    <FrameLayout
        android:id="@+id/codeBox"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:padding="8dp">

        <ImageView
            android:id="@+id/qr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/share_qr"
            android:contentDescription="@string/qr_code" />
    </FrameLayout>

    <TextView
        android:id="@+id/link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:textColor="#003869"
        android:textSize="18sp"
        android:fontFamily="@font/inter_bold" />
</LinearLayout>
