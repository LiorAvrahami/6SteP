<?xml version="1.0" encoding="utf-8"?>
<!-- The heart page, as the user drew it (design/app_layout.free, revised 2026-10-28): upright, the note on top and the
     three links in a row under it; square boxes with black outlines (set in HeartActivity). The beer's words open with
     the $ button (user 2026-10-29), in dialog_beer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="18dp"
        android:text="@string/heart_note"
        android:textColor="#000000"
        android:fontFamily="@font/inter_regular"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="24sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/mail"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_at"
            android:contentDescription="@string/email_me" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/web"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_globe"
            android:contentDescription="@string/my_website" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/money"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dollar"
            android:contentDescription="@string/buy_beer" />
    </LinearLayout>
</LinearLayout>
