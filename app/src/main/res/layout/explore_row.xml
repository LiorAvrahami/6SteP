<?xml version="1.0" encoding="utf-8"?>
<!-- a row of the explore page (the user's choice, 2026-10-29): the piece's name, and under it its versions as pills when
     they all fit (option B), otherwise a button at the right of the name with a count badge that opens a list (option A);
     a piece with one version shows where it starts and ends as plain text. Then its strip of three step pictures. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:layout_marginStart="20dp"
    android:layout_marginBottom="12dp"
    android:clipChildren="false"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/rowName"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/rowColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#000000"
                android:textSize="20sp"
                android:fontFamily="@font/inter_semibold" />

            <TextView
                android:id="@+id/rowFacing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:textColor="#5C4448"
                android:textSize="13sp"
                android:fontFamily="@font/inter_semibold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/rowPills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal"
                android:visibility="invisible" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/rowChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:clipChildren="false"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/rowChipBox"
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="15dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/rowChipText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="0.95"
                    android:maxLines="2"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_extrabold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="10dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down" />
            </LinearLayout>

            <TextView
                android:id="@+id/rowChipCount"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:minWidth="22dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:fontFamily="@font/inter_extrabold" />
        </FrameLayout>
    </LinearLayout>

    <org.lior.sixstep.StepStrip
        android:id="@+id/rowStrip"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:background="#FFFFFF" />
</LinearLayout>
