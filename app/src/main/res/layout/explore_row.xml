<?xml version="1.0" encoding="utf-8"?>
<!-- a row of the explore page: the piece's name with its version box at the right (where it starts and ends; for an
     element with several versions, a dropdown), and its strip of three step pictures (white) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:layout_marginStart="20dp"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/rowName"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#000000"
            android:textSize="20sp"
            android:fontFamily="@font/inter_semibold" />

        <TextView
            android:id="@+id/rowVersion"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:maxLines="2"
            android:minWidth="108dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#000000"
            android:textSize="12sp"
            android:fontFamily="@font/inter_extrabold" />
    </LinearLayout>

    <org.lior.sixstep.StepStrip
        android:id="@+id/rowStrip"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:background="#FFFFFF" />
</LinearLayout>
